{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jaminben/secure-applemusic-mcp-for-osx",
  "description": "Hardened macOS-only Apple Music MCP server: playlists, library, catalog and playback through Music.app. No Accessibility, no browser automation, no stored credentials.",
  "repository": {
    "url": "https://github.com/jaminben/secure-applemusic-mcp-for-osx",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "secure-applemusic-mcp-for-osx",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
